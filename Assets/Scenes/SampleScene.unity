  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlanetInteractable
  planetName: Moon
  generalInformation: Bulan adalah satu-satunya satelit alami Bumi. Ia merupakan
    benda langit paling terang kedua di langit setelah Matahari dan gravitasi Bulan
    sangat mempengaruhi pasang surut air laut di Bumi.
  narrationAudio: {fileID: 8300000, guid: bf07c4c63735d4c1abb4dcdf4b190d5e, type: 3}
  specificQuizQuestions:
  - questionText: Apa fase bulan saat permukaannya gelap dan tidak mendapat cahaya
      matahari?
    answers:
    - Bulan Sabit
    - Bulan Purnama
    - Bulan Baru (New Moon)
    - Bulan Cembung
    correctAnswerIndex: 2
  - questionText: Siapakah manusia pertama yang berjalan di permukaan Bulan?
    answers:
    - Yuri Gagarin
    - Buzz Aldrin
    - Neil Armstrong
    - Alan Shepard
    correctAnswerIndex: 2
  - questionText: Berapa lama waktu yang dibutuhkan Bulan untuk mengelilingi Bumi?
    answers:
    - Sekitar 7 hari
    - Sekitar 14 hari
    - Sekitar 27,3 hari
    - Sekitar 365 hari
    correctAnswerIndex: 2
  animator: {fileID: 0}
  actionAnimationTrigger: PlayAction
  targetToScale: {fileID: 0}
