  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlanetInteractable
  planetName: Sun
  generalInformation: Matahari adalah bintang yang berada tepat di pusat Tata Surya
    kita. Ia merupakan bola plasma panas raksasa yang bercahaya dan menjadi sumber
    energi terpenting bagi seluruh kehidupan di Bumi.
  narrationAudio: {fileID: 8300000, guid: 77709badfff32409294d16b1f417c794, type: 3}
  specificQuizQuestions:
  - questionText: Reaksi apa yang terjadi di inti Matahari yang menghasilkan panas
      dan cahaya?
    answers:
    - Fisi Nuklir
    - Reaksi Kimia
    - Fusi Nuklir
    - Elektromagnetik
    correctAnswerIndex: 2
  - questionText: Apa nama lapisan atmosfer paling luar dari Matahari saat terjadi
      gerhana?
    answers:
    - Kromosfer
    - Fotosfer
    - Korona
    - Zona Radiatif
    correctAnswerIndex: 2
  - questionText: Unsur gas apa yang paling banyak kedua di Matahari setelah Hidrogen?
    answers:
    - Oksigen
    - Karbon
    - Helium
    - Nitrogen
    correctAnswerIndex: 2
  animator: {fileID: 0}
  actionAnimationTrigger: PlayAction
  targetToScale: {fileID: 0}
